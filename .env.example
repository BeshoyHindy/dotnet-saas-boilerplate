# ─────────────────────────────────────────────────────────────────────
# Settings for the LOCAL docker-compose stack (./docker-compose.yml).
#
# You normally do not copy this file. Run `bash scripts/local-env.sh`: it
# writes a .env containing just the four secrets, generated fresh. Everything
# else already has the default shown below, so only add a key here if you want
# to change it (a free host port, a different bucket name, an OTLP collector).
#
# Never commit .env.
# ─────────────────────────────────────────────────────────────────────

# ── Secrets — no defaults, generated by scripts/local-env.sh ──────────
# The containers run as Production, and ProductionConfigurationGuard refuses to
# boot on a secret that carries a template marker ("dev-only", "changeme",
# "password", …). So these cannot ship with a placeholder value, and compose
# fails naming the variable if one is missing. To make them by hand:
#   POSTGRES_PASSWORD / MINIO_ROOT_PASSWORD   openssl rand -base64 24 | tr -dc 'A-Za-z0-9'
#   JWT_SIGNING_KEY    32+ characters         openssl rand -base64 48 | tr -dc 'A-Za-z0-9'
#   SEED_ADMIN_PASSWORD  10+ chars, needs an upper, a lower and a digit
POSTGRES_PASSWORD=
MINIO_ROOT_PASSWORD=
JWT_SIGNING_KEY=
SEED_ADMIN_PASSWORD=

# ── Host ports ───────────────────────────────────────────────────────
APP_API_PORT=8080
APP_CONSOLE_PORT=8081
MAILPIT_UI_PORT=8025
# Aspire binds 9000/9001 for its own persistent MinIO — change these if you want
# to run `docker compose up` alongside a running AppHost.
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# ── Public URLs the browser uses ─────────────────────────────────────
# The console's own origin: the API's CORS allow-list and the origin it puts in
# mailed links (password reset, email confirmation). Must match the port above.
# The browser never calls the API directly — the console proxies /api to it — so
# there is no browser-facing API URL to configure.
APP_CONSOLE_URL=http://localhost:8081

# Tenant identifier the login form pre-fills.
APP_DEFAULT_TENANT=root

# ── Data plane (compose-internal, not published on host ports) ───────
POSTGRES_DB=boilerplate
POSTGRES_USER=boilerplate
MINIO_ROOT_USER=boilerplate
STORAGE_BUCKET=boilerplate
# Valkey runs without authentication on purpose — it is reachable only from
# inside the compose network.

# ── Application ──────────────────────────────────────────────────────
# Host header allow-list. Semicolon-separated; "*" is rejected in Production.
ALLOWED_HOSTS=localhost;127.0.0.1;api

# ── Observability (optional) ─────────────────────────────────────────
# Point at an OTLP collector to ship traces/metrics. Blank disables export.
OTEL_EXPORTER_OTLP_ENDPOINT=
