<Project>
	<PropertyGroup>
		<!-- Target framework -->
		<TargetFramework>net10.0</TargetFramework>

		<!-- Enable latest C# features and diagnostics -->
		<LangVersion>latest</LangVersion>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>

		<!-- Code quality & analysis. Warnings are errors locally so the
		     dev loop matches CI (.github/workflows/backend.yml passes
		     -warnaserror to dotnet build); previously the divergence
		     let analyzer regressions slip through to CI. -->
		<TreatWarningsAsErrors>true</TreatWarningsAsErrors>
		<CodeAnalysisTreatWarningsAsErrors>true</CodeAnalysisTreatWarningsAsErrors>
		<EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
		<AnalysisLevel>latest</AnalysisLevel>
		<AnalysisMode>AllEnabledByDefault</AnalysisMode>

		<!-- Docs -->
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<NoWarn>$(NoWarn);CS1591;MSG0005;CA1054;CA1056</NoWarn>
		<!-- Suppress warning about missing XML docs -->

		<!-- Prevent MSBuild from excluding common folders (optional) -->
		<NoDefaultExcludes>true</NoDefaultExcludes>
	</PropertyGroup>

	<ItemGroup>
		<!-- Sonar Analyzer for deep static analysis -->
		<PackageReference Include="SonarAnalyzer.CSharp">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
		</PackageReference>
	</ItemGroup>

	<PropertyGroup>
		<!-- Default NuGet metadata -->
		<Authors>Boilerplate</Authors>
		<Company>Boilerplate</Company>
		<Version>10.0.0</Version>
		<PackageTags>Modular;CQRS;VerticalSlice;DotNet;CleanArchitecture</PackageTags>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<Description>A production-ready modular .NET starter for building multi-tenant SaaS applications.</Description>
		<!--
		  Distribution model = SOURCE OWNERSHIP. Nothing here ships to NuGet.org at all:
		  the distribution artifact is this repository itself, installed as a
		  `dotnet new` template (`dotnet new install <path>`, ADR-0001). The template
		  scaffolds full, owned source; modules/framework are consumed via
		  ProjectReference, never as binary NuGets. So pack is OFF for every project
		  here, which prevents the module/framework projects from accidentally emitting
		  orphan, mutually-unresolvable binary packages.
		-->
		<IsPackable>false</IsPackable>
	</PropertyGroup>

	<!-- Reproducible, debuggable packages, should any project under src/ opt back in. -->
	<PropertyGroup Condition="'$(IsPackable)' == 'true'">
		<Deterministic>true</Deterministic>
		<ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
		<PublishRepositoryUrl>true</PublishRepositoryUrl>
		<EmbedUntrackedSources>true</EmbedUntrackedSources>
		<IncludeSymbols>true</IncludeSymbols>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>
	</PropertyGroup>

	<ItemGroup Condition="'$(IsPackable)' == 'true'">
		<!-- Include root README.md in NuGet packages -->
		<None Include="$(MSBuildThisFileDirectory)../README.md" Pack="true" PackagePath="/" />
		<PackageReference Include="Microsoft.SourceLink.GitHub" PrivateAssets="all" />
	</ItemGroup>
</Project>
