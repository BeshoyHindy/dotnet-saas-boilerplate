<Project Sdk="Aspire.AppHost.Sdk/13.5.4">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UserSecretsId>9fe5df9a-b9b2-4202-bdb4-d30b01b71d1a</UserSecretsId>
    <IsPackable>false</IsPackable>
    <!-- Aspire 13.5 warns when the AppHost runs without the Aspire CLI bundle. `dotnet run` on the
         AppHost is the supported entry point here and needs none of the bundle's features. -->
    <NoWarn>$(NoWarn);ASPIRE010</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.JavaScript" />
    <PackageReference Include="Aspire.Hosting.PostgreSQL" />
    <PackageReference Include="Aspire.Hosting.Redis" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Boilerplate.Api\Boilerplate.Api.csproj" />
    <ProjectReference Include="..\Boilerplate.DbMigrator\Boilerplate.DbMigrator.csproj" />
  </ItemGroup>

</Project>
