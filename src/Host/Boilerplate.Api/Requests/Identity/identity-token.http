@baseUrl = https://localhost:7030
@tenant = root
# The seeded root admin's password is generated, never a literal in the repository: paste it from
# the Aspire dashboard (Resources → Parameters) or SEED_ADMIN_PASSWORD in .env. Don't commit it.
@adminPassword =

### Issue JWT token
POST {{baseUrl}}/api/v1/tenants/{{tenant}}/auth/token
Content-Type: application/json

{
  "email": "admin@root.com",
  "password": "{{adminPassword}}"
}

### Refresh JWT token
# Anonymous, so the tenant rides in the route (ADR-0002): the access token may be expired.
POST {{baseUrl}}/api/v1/tenants/{{tenant}}/auth/refresh
Content-Type: application/json

{
  "token": "{{access_token}}",
  "refreshToken": "{{refresh_token}}"
}
