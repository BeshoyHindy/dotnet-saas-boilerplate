{
  "Serilog": {
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Message:lj} (tenant: {Tenant}, user: {UserId}, correlation: {CorrelationId}){NewLine}{Exception}"
        }
      }
    ]
  },
  "CorsOptions": {
    "AllowAll": true
  },
  "OpenApiOptions": {
    "Enabled": true
  },
  "OpenTelemetryOptions": {
    "Exporter": {
      "Otlp": {
        "Enabled": false
      }
    }
  },
  "MailOptions": {
    "UseSendGrid": false,
    "From": "noreply@example.com",
    "DisplayName": "Boilerplate",
    "SMTP": {
      "Host": "smtp.ethereal.email",
      "Port": 587,
      "UserName": "",
      "Password": ""
    }
  }
}
