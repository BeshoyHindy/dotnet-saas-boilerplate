<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>Boilerplate.Architecture.Tests</AssemblyName>
    <RootNamespace>Boilerplate.Architecture.Tests</RootNamespace>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsPublishable>false</IsPublishable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- S125: SonarAnalyzer false-positives on descriptive comments with code-like tokens (not dead code). -->
    <NoWarn>$(NoWarn);CA1515;CA1861;CA1707;CA1307;S125</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="coverlet.collector">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="NetArchTest.Rules" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Shouldly" />
    <PackageReference Include="AutoFixture" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\BuildingBlocks\Core\Boilerplate.BuildingBlocks.Core.csproj" />
    <ProjectReference Include="..\..\BuildingBlocks\Persistence\Boilerplate.BuildingBlocks.Persistence.csproj" />
    <ProjectReference Include="..\..\BuildingBlocks\Shared\Boilerplate.BuildingBlocks.Shared.csproj" />
    <ProjectReference Include="..\..\BuildingBlocks\Web\Boilerplate.BuildingBlocks.Web.csproj" />
    <ProjectReference Include="..\..\Modules\Auditing\Modules.Auditing\Boilerplate.Modules.Auditing.csproj" />
    <ProjectReference Include="..\..\Modules\Auditing\Modules.Auditing.Contracts\Boilerplate.Modules.Auditing.Contracts.csproj" />
    <ProjectReference Include="..\..\Modules\Identity\Modules.Identity\Boilerplate.Modules.Identity.csproj" />
    <ProjectReference Include="..\..\Modules\Identity\Modules.Identity.Contracts\Boilerplate.Modules.Identity.Contracts.csproj" />
    <ProjectReference Include="..\..\Modules\Multitenancy\Modules.Multitenancy\Boilerplate.Modules.Multitenancy.csproj" />
    <ProjectReference Include="..\..\Modules\Multitenancy\Modules.Multitenancy.Contracts\Boilerplate.Modules.Multitenancy.Contracts.csproj" />
    <ProjectReference Include="..\..\Modules\Files\Modules.Files\Boilerplate.Modules.Files.csproj" />
    <ProjectReference Include="..\..\Modules\Files\Modules.Files.Contracts\Boilerplate.Modules.Files.Contracts.csproj" />
    <ProjectReference Include="..\..\Modules\Chat\Modules.Chat\Boilerplate.Modules.Chat.csproj" />
    <ProjectReference Include="..\..\Modules\Chat\Modules.Chat.Contracts\Boilerplate.Modules.Chat.Contracts.csproj" />
    <ProjectReference Include="..\..\Host\Boilerplate.Api\Boilerplate.Api.csproj" />
    <ProjectReference Include="..\..\Host\Boilerplate.Migrations.PostgreSQL\Boilerplate.Migrations.PostgreSQL.csproj" />
  </ItemGroup>
</Project>
