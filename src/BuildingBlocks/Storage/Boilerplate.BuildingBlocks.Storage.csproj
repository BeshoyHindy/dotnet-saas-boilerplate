<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<RootNamespace>Boilerplate.BuildingBlocks.Storage</RootNamespace>
		<AssemblyName>Boilerplate.BuildingBlocks.Storage</AssemblyName>
		<NoWarn>$(NoWarn);CA1031;CA1056;CA1002;CA2227;CA1812;CA1308;CA1062</NoWarn>
	</PropertyGroup>
	
	<ItemGroup>
		<ProjectReference Include="..\Core\Boilerplate.BuildingBlocks.Core.csproj" />
		<ProjectReference Include="..\Shared\Boilerplate.BuildingBlocks.Shared.csproj" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Finbuckle.MultiTenant" />
		<PackageReference Include="Finbuckle.MultiTenant.Abstractions" />
	</ItemGroup>
	
	<ItemGroup>
	  <Folder Include="AWS\" />
	</ItemGroup>
	
	<ItemGroup>
		<FrameworkReference Include="Microsoft.AspNetCore.App" />
	</ItemGroup>

	<ItemGroup>
	  <PackageReference Include="AWSSDK.S3" />
	</ItemGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="Boilerplate.Integration.Tests" />
		<!-- S3StorageService is internal; its tenant-key enforcement is unit-tested against a
		     substituted IAmazonS3, which is what makes "refused before any call reaches the
		     backend" assertable rather than merely stated. -->
		<InternalsVisibleTo Include="Boilerplate.Framework.Tests" />
	</ItemGroup>

</Project>
