# Copy to .sandcastle/.env (git-ignored) and fill in. The `sandcastle` package
# script loads it on the host.
#
# EVERY KEY LISTED HERE REACHES EVERY SANDBOX. The sandcastle library exports
# each key named in this file, with its value from here or from the host env,
# into the environment of every sandbox it starts, and the healer runs on the
# host with the host env. That is how the agents get their credentials, and it
# means each token below (the main Claude token, the fallback one, GH_TOKEN) is
# readable by every agent in every sandbox, whether or not a phase uses it.
# The file itself is never copied into a sandbox.

# Claude Code OAuth token — get one by running `claude setup-token` on your host.
# Lets the agents use your Claude subscription instead of an API key.
CLAUDE_CODE_OAUTH_TOKEN=
#
# Fallback Claude account — OFF by default. With SANDCASTLE_FALLBACK_ACCOUNT=on,
# a phase whose model stops answering on the main account (a usage limit) is
# re-run at once on this second account, and new phases move back to the main
# account as soon as a probe shows it answers again. Needs the usage-limit wait
# below. The token must be listed HERE, not only exported from the shell, or it
# never reaches a sandbox; and like every key here it reaches every sandbox
# even while the switch is off. A blank token, a switch other than on/off, or
# ANTHROPIC_API_KEY set alongside it stops the run before it starts; a token
# the startup probe cannot use is dropped with a warning.
SANDCASTLE_FALLBACK_ACCOUNT=off
CLAUDE_CODE_OAUTH_TOKEN_FALLBACK=
# Or use an Anthropic API key instead — uncomment and fill in:
# ANTHROPIC_API_KEY=
#
# GitHub personal access token — the agents use it to read and manage issues.
# Create a fine-grained token: https://github.com/settings/personal-access-tokens/new
# Required repository permissions: Issues (Read and write) and Metadata (Read).
GH_TOKEN=
#
# Hard cap on simultaneously running issue sandboxes (per-machine tuning).
# Optional — blank/unset falls back to `limits.maxConcurrentAgents` in
# sandcastle.config.mts, where the sizing math is written down. Budget ~3-4 GB
# of Docker RAM per agent before raising it. Pre-filled with the config default.
MAX_CONCURRENT_AGENTS=3
#
# How many times a RED post-merge gate is handed to a healer agent before the
# run stops as red. Optional — blank/unset falls back to `limits.healAttempts`,
# which is 0: healing is OFF by default because the healer runs ON THE HOST with
# permission prompts bypassed (ADR-0006). Set to 2 to opt in for a run.
SANDCASTLE_HEAL_ATTEMPTS=0
#
# Usage-limit wait. When a phase fails and a probe of its model gets no answer
# (a spent subscription, or an outage), the phase waits and re-runs instead of
# ending the run. Optional — blank/unset falls back to `limits.usagePollMinutes`
# and `limits.usageMaxWaitHours` in sandcastle.config.mts. Whole numbers: probe
# every N minutes (>= 1), give up after N hours per phase call, counted from its
# first limit hit (>= 0; 0 turns the wait off). A startup probe turns the wait
# off for the run when the host `claude` CLI cannot probe. Pre-filled with the
# config defaults.
SANDCASTLE_USAGE_POLL_MINUTES=5
SANDCASTLE_USAGE_MAX_WAIT_HOURS=6
#
# Per-phase model and reasoning effort, so trying a new model needs no code
# edit. Pre-filled with the current defaults from `models` in
# sandcastle.config.mts, where the reasoning behind each phase's choice is
# written down. Once copied to .env these values WIN over that file, so a later
# change there has no effect until you update or blank the key here; a blank
# key falls back to the config value. A model must be a Claude id
# (`claude-…`); a "[1m]" suffix is the Claude Code 1M-context selector. Effort
# must be exactly one of: low, medium, high, xhigh, max. A typo stops the run
# before anything starts; `pnpm sandcastle --dry-run` shows what a run would
# use and marks each value that came from .env.
SANDCASTLE_PLANNER_MODEL=claude-sonnet-5
SANDCASTLE_PLANNER_EFFORT=medium
SANDCASTLE_IMPLEMENTER_MODEL=claude-opus-5-5
SANDCASTLE_IMPLEMENTER_EFFORT=high
SANDCASTLE_REVIEWER_MODEL=claude-fable-5-1[1m]
SANDCASTLE_REVIEWER_EFFORT=medium
SANDCASTLE_MERGER_MODEL=claude-sonnet-5
SANDCASTLE_MERGER_EFFORT=xhigh
SANDCASTLE_HEALER_MODEL=claude-opus-5-5
SANDCASTLE_HEALER_EFFORT=medium
