# Copy to .sandcastle/.env (git-ignored) and fill in. The `sandcastle` package
# script loads it; nothing here is ever read inside a sandbox.

# Claude Code OAuth token — get one by running `claude setup-token` on your host.
# Lets the agents use your Claude subscription instead of an API key.
CLAUDE_CODE_OAUTH_TOKEN=
# Or use an Anthropic API key instead — uncomment and fill in:
# ANTHROPIC_API_KEY=
#
# GitHub personal access token — the agents use it to read and manage issues.
# Create a fine-grained token: https://github.com/settings/personal-access-tokens/new
# Required repository permissions: Issues (Read and write) and Metadata (Read).
GH_TOKEN=
#
# Hard cap on simultaneously running issue sandboxes (per-machine tuning).
# Optional — blank/unset falls back to `limits.maxConcurrentAgents` in
# sandcastle.config.mts, where the sizing math is written down. Budget ~3-4 GB
# of Docker RAM per agent before raising it.
MAX_CONCURRENT_AGENTS=
#
# How many times a RED post-merge gate is handed to a healer agent before the
# run stops as red. Optional — blank/unset falls back to `limits.healAttempts`,
# which is 0: healing is OFF by default because the healer runs ON THE HOST with
# permission prompts bypassed (ADR-0006). Set to 2 to opt in for a run.
SANDCASTLE_HEAL_ATTEMPTS=
#
# Per-phase model and reasoning effort, so trying a new model needs no code
# edit. Optional — each blank/unset key falls back to `models` in
# sandcastle.config.mts, where the reasoning behind each phase's choice is
# written down. A model must be a Claude id (`claude-…`); a "[1m]" suffix, e.g.
# `claude-opus-5-5[1m]`, is the Claude Code 1M-context selector. Effort must be
# exactly one of: low, medium, high, xhigh, max. A typo stops the run before
# anything starts; check what a run would use with `pnpm sandcastle --dry-run`.
SANDCASTLE_PLANNER_MODEL=
SANDCASTLE_PLANNER_EFFORT=
SANDCASTLE_IMPLEMENTER_MODEL=
SANDCASTLE_IMPLEMENTER_EFFORT=
SANDCASTLE_REVIEWER_MODEL=
SANDCASTLE_REVIEWER_EFFORT=
SANDCASTLE_MERGER_MODEL=
SANDCASTLE_MERGER_EFFORT=
SANDCASTLE_HEALER_MODEL=
SANDCASTLE_HEALER_EFFORT=
