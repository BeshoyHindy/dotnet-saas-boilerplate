# ─────────────────────────────────────────────────────────────────────
# Dokploy environment contract (ADR-0005) — KEY NAMES ONLY.
#
# This file is the list of variables the two compose stacks interpolate. It
# ships with NO values: the real ones are typed into the Environment tab of the
# matching Dokploy Compose service, which writes them next to the compose file
# at deploy time. Nothing here is ever a secret, and this file is never copied
# onto a server.
#
# Every key below is used by at least one stack, and every ${VAR} in either
# stack is listed below — deploy/dokploy/tests enforce both directions, so a
# variable cannot be added to a compose file without being documented here.
#
# There are NO defaults in the compose files on purpose. `docker compose` warns
# and substitutes an empty string for a variable you forgot, which turns a typo
# into an empty connection string or an empty AllowedHosts. Setting every key
# explicitly per environment means a missing one fails loudly at boot instead.
#
# Scope column: which stack reads the key.
#   [data]  data-services.compose.yml
#   [app]   app.compose.yml
#   [both]  set the same value in both Environment tabs
#
# Walkthrough, including how to derive the two values you cannot invent
# (PROXY_KNOWN_NETWORK and the image tag): docs/deploy-dokploy.md
# ─────────────────────────────────────────────────────────────────────

# ── Identity of this environment ─────────────────────────────────────
# [both] Unique per environment on a Dokploy server ("boilerplate-staging",
# "boilerplate-production"). It prefixes every dokploy-network alias and every
# Traefik router/service/middleware name, which is what lets staging and
# production run the same two files side by side without colliding.
STACK_NAME=

# ── Images (app stack, pull-only) ────────────────────────────────────
# [app] Registry host. ghcr.io unless the images are mirrored.
IMAGE_REGISTRY=
# [app] GHCR owner, lowercase — the GitHub user or organisation that owns the
# packages. Images: <owner>/boilerplate-api, /boilerplate-db-migrator,
# /boilerplate-console.
IMAGE_OWNER=
# [app] The one value that differs between a deploy and a rollback. Staging
# tracks develop (dev-<sha>); production tracks a v* tag on main and uses the
# version (1.4.0). Never "latest" in production — a redeploy must be able to
# reproduce byte-for-byte what is already running.
IMAGE_TAG=

# ── Domains and TLS ──────────────────────────────────────────────────
# [app] Public hostname of the API, without scheme (api.example.com).
API_DOMAIN=
# [app] Public hostname of the console (app.example.com).
CONSOLE_DOMAIN=
# [both] Public hostname of object storage (storage.example.com). The browser
# fetches presigned URLs from it, so it must resolve publicly.
STORAGE_DOMAIN=
# [both] Traefik certificate resolver. "letsencrypt" on a stock Dokploy server.
TRAEFIK_CERT_RESOLVER=

# ── Application host rules ───────────────────────────────────────────
# [app] Semicolon-separated Host allow-list. Must contain API_DOMAIN; "*" is
# rejected and the API refuses to boot. Traefik's readiness probe sends
# API_DOMAIN as its Host, so an omission reads as a permanently down backend.
ALLOWED_HOSTS=
# [app] CIDR of the Docker network Traefik reaches the API from, e.g.
# 10.0.0.0/8. Production enables forwarded headers with TrustAnyProxy=false, so
# the boot fails until this names a network. Read it off the server with:
#   docker network inspect dokploy-network \
#     -f '{{range .IPAM.Config}}{{.Subnet}}{{end}}'
PROXY_KNOWN_NETWORK=

# ── PostgreSQL ───────────────────────────────────────────────────────
# [both] Database and role names.
POSTGRES_DB=
POSTGRES_USER=
# [both] Generate it, do not invent it. The API runs as Production and refuses
# to boot on anything that looks like a template placeholder:
#   openssl rand -base64 24 | tr -dc 'A-Za-z0-9'
POSTGRES_PASSWORD=

# ── Object storage (MinIO) ───────────────────────────────────────────
# [both] MinIO root credentials; also the S3 access/secret key pair the API
# signs with. Generate the password as above.
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
# [both] Bucket the Files module writes to; created once by the minio-init
# service in the data stack.
STORAGE_BUCKET=
# [app] S3 region name. MinIO accepts any value; us-east-1 is the convention.
STORAGE_REGION=

# ── Application secrets ──────────────────────────────────────────────
# [app] JWT signing key, 32+ characters:
#   openssl rand -base64 48 | tr -dc 'A-Za-z0-9'
JWT_SIGNING_KEY=
# [app] Password of the seeded root admin. Read by the migrator only. 10+
# characters with an upper, a lower and a digit. Change it at first sign-in.
SEED_ADMIN_PASSWORD=

# ── Outbound mail ────────────────────────────────────────────────────
# [app] Envelope sender and display name on confirmation / password-reset mail.
MAIL_FROM=
MAIL_DISPLAY_NAME=
# [app] Relay. SMTP_SECURE_SOCKET is StartTls, SslOnConnect, Auto or None;
# StartTls is the right answer for a real relay and None only for a plain-text
# catcher on a private network.
SMTP_HOST=
SMTP_PORT=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SECURE_SOCKET=

# ── Console ──────────────────────────────────────────────────────────
# [app] Tenant identifier the sign-in form pre-fills ("root").
APP_DEFAULT_TENANT=

# ── Observability ────────────────────────────────────────────────────
# [app] Whether traces and metrics are exported at all: "true" or "false".
# Production ships the OTLP exporter disabled, so an endpoint without this set
# to true exports nothing — set both or neither.
OTEL_EXPORTER_ENABLED=
# [app] OTLP collector endpoint, e.g. http://collector:4317. Leave it empty when
# OTEL_EXPORTER_ENABLED is false; the key still has to be present, because there
# are no defaults.
OTEL_EXPORTER_OTLP_ENDPOINT=
